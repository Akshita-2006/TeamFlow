MONGO_URI=mongodb://127.0.0.1:27017/teamflow
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Production example after Vercel deploy:
# CLIENT_URL=https://your-teamflow-app.vercel.app
PORT=5000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeamFlow <noreply@example.com>

# Optional cloud uploads. MongoDB remains the primary database.
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teamflow-uploads

# Optional AWS S3 alternative
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional if you use CloudFront/custom public base URL
AWS_S3_PUBLIC_BASE_URL=
